# ===== 错题本应用部署配置 =====
# 复制此文件为 .env 并修改其中的值（.env 已被 git 忽略，不会提交）
# cp .env.example .env

# 数据库配置（服务器上使用宝塔/系统自带的 MySQL）
DB_NAME=mistakenote
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_PORT=3306

# JWT 密钥（至少32位随机字符串，可用 openssl rand -hex 32 生成）
JWT_SECRET=your-random-jwt-secret-at-least-32-chars

# DeepSeek API Key（对话、分析、生成练习；留空则 AI 功能不可用）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 火山引擎 ARK API Key（图片文字识别 OCR）
ARK_API_KEY=your-ark-api-key
